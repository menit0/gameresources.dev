---
import ToolItem from "./ToolItem.astro";

const { title, tools } = Astro.props;
const isLarge = tools.length > 8;
---

<section class={isLarge ? "is-large" : ""}>
  <h2>{title}</h2>
  <ul class={isLarge ? "grid-list" : ""}>
    {
      tools.map((tool: any) => {
        return (
          <li>
            <ToolItem name={tool.data.name} url={tool.data.url} />
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  section {
    padding: 1.5rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  section h2 {
    font-size: 1rem;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    section.is-large {
      grid-column: span 2;
    }

    ul.grid-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-template-rows: repeat(8, auto);
      column-gap: 3rem;
    }
  }
</style>
