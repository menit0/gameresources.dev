---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ToolSection from "@components/ToolSection.astro";

const engines = await getCollection("engines");
const threed = await getCollection("threed");
const assets = await getCollection("assets");
const audio = await getCollection("audio");
const backend = await getCollection("backend");
const ui = await getCollection("ui");
const organization = await getCollection("organization");
const marketing = await getCollection("marketing");
const twod = await getCollection("twod");
const code = await getCollection("code");
const media = await getCollection("media");
const jobs = await getCollection("jobs");
---

<Layout>
  <div class="grid">
    <ToolSection title="Engines & Frameworks" tools={engines} />

    <ToolSection title="3D" tools={threed} />

    <ToolSection title="Assets" tools={assets} />
    <ToolSection title="Audio" tools={audio} />

    <ToolSection title="Backend & Multiplayer" tools={backend} />

    <ToolSection title="UI" tools={ui} />

    <ToolSection title="Organization" tools={organization} />

    <ToolSection title="Marketing & PR" tools={marketing} />

    <ToolSection title="2D" tools={twod} />

    <ToolSection title="Code" tools={code} />

    <ToolSection title="Media" tools={media} />

    <ToolSection title="Jobs" tools={jobs} />
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));

    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
